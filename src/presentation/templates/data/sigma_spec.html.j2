{% extends "data/base.html.j2" %}
{% from "shared/_dir_browser.html.j2" import dir_browser_card %}

{% block title %}Specification Repositories - Data Sources{% endblock %}

{% block page_content %}
<h1>Specification Repositories</h1>
<p>Manage GitHub repositories for Sigma specification indexing.</p>

<div class="card">
    <div class="github-actions">
        <button id="add-repo-btn" class="btn btn-primary" type="button">Add Repository</button>
        <button id="sync-all-btn" class="btn btn-success" type="button">Sync All</button>
        <button id="refresh-btn" class="btn btn-primary" type="button">Refresh list</button>
        <button id="list-document-btn" class="btn btn-primary" type="button">List document</button>
        <button id="index-btn" class="btn btn-success" type="button">Index</button>
    </div>

    <div id="repos-list" class="repos-grid"></div>

    <div id="select-repo-prompt" class="select-repo-prompt" style="display: none;">
        <p>Click "Browse" on a repository to view and select directories for indexing.</p>
    </div>
</div>

<div id="repo-detail" class="repo-detail-section" style="display: none;">
    <div class="repo-detail-header">
        <h2 id="selected-repo-name">Repository</h2>
        <button id="close-detail-btn" class="btn btn-secondary" type="button">Close</button>
    </div>

    {{ dir_browser_card(id="spec", mode="tree", title="Select Directories to Index") }}
</div>

<div id="add-repo-modal" class="modal" style="display: none;">
    <div class="modal-content">
        <h2>Add Specification Repository</h2>
        <form id="add-repo-form">
            <div class="form-group">
                <label for="repo-url">Repository (owner/repo)</label>
                <input type="text" id="repo-url" name="url" placeholder="SigmaHQ/sigma-specification" required>
            </div>
            <div class="form-group">
                <label for="repo-branch">Branch</label>
                <input type="text" id="repo-branch" name="branch" placeholder="main" value="main">
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Add</button>
                <button id="modal-cancel-btn" type="button" class="btn btn-secondary">Cancel</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block scripts %}
{{ super() }}
<script src="{{ url_for('static', path='/js/internal/sigma-spec.js') }}"></script>
{% endblock %}

{% block styles %}
{{ super() }}
<style>
.repo-info { padding: 1rem; }
.repo-info h3 { margin-top: 0; }
.error-message { color: var(--color-danger); padding: 0.75rem; text-align: center; background: var(--chat-message-error-bg); border-radius: 4px; }
.table { width: 100%; border-collapse: collapse; margin-top: 0.5rem; }
.table th, .table td { padding: 0.5rem; text-align: left; border-bottom: 1px solid var(--border-card); }
.table th { font-weight: 600; }
</style>
{% endblock %}
