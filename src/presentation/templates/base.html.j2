<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Sigmahqrag{% endblock %}</title>
    <link rel="icon" type="image/x-icon" href="{{ url_for('static', path='/favicon.ico') }}">
    <script>!function(){var t=localStorage.getItem("sigmahqrag-theme");if(t==="dark"){document.documentElement.setAttribute("data-theme","dark")}}()</script>
    <link rel="stylesheet" href="{{ url_for('static', path='/css/base/theme.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', path='/css/legacy.css') }}">
    {% block styles %}{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">
    {% include 'shared/_header.html.j2' %}

    <main>
        {% block content %}{% endblock %}
    </main>

    {% block footer %}
    <footer>
        <p>&copy; 2026 Sigmahqrag - Local RAG for Sigma Rules</p>
    </footer>
    {% endblock %}

    {% block scripts %}{% endblock %}
</body>
</html>
