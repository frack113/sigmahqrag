#!/bin/sh
# Pre-commit hook: enforce .gitignore + run ruff check + black --check on staged Python files.

# === 1. Prevent committing ignored files ===
files=$(git diff --cached --name-only)
if [ -z "$files" ]; then
    exit 0
fi

ignored=$(echo "$files" | git check-ignore --stdin 2>/dev/null)
if [ $? -eq 0 ] && [ -n "$ignored" ]; then
    echo ""
    echo "ERROR: Refusing to commit files ignored by .gitignore:"
    echo "$ignored" | while IFS= read -r f; do echo "  $f"; done
    echo ""
    echo "Unstage them: git reset HEAD -- <file>"
    echo "To bypass (not recommended): git commit --no-verify"
    exit 1
fi

# === 2. Run linting on staged Python files ===
py_files=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)
if [ -z "$py_files" ]; then
    exit 0
fi

echo ""
echo "Running pre-commit checks on staged Python files..."

# Run ruff check
uv run ruff check $py_files
if [ $? -ne 0 ]; then
    echo ""
    echo "ruff check FAILED - fix with: uv run ruff check $py_files"
    exit 1
fi

# Run black --check
uv run black --check $py_files
if [ $? -ne 0 ]; then
    echo ""
    echo "black --check FAILED - fix with: uv run black $py_files"
    exit 1
fi

echo "All checks passed."
